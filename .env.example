# ======================
# Neon PostgreSQL
# ======================
# Get this from https://console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/garage?sslmode=require"

# ======================
# JWT Authentication
# ======================
# Generate a strong random string for production (e.g. openssl rand -base64 32)
JWT_SECRET="change-me-to-a-long-random-secret"

# Optional seed defaults
SEED_ADMIN_EMAIL="admin@garage.local"
SEED_ADMIN_PASSWORD="admin12345"
SEED_ADMIN_NAME="Garage Admin"

# ======================
# Cloudflare R2
# ======================
# Bound via wrangler.toml. Create bucket "garage-images" in Cloudflare dashboard.

# ======================
# Frontend
# ======================
VITE_API_URL="http://localhost:8787"

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@garage/database": ["../../packages/database/src"],
      "@garage/shared": ["../../packages/shared/src"]
    }
  },
  "include": ["src/**/*"]
}

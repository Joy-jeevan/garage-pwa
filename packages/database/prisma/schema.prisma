// Prisma schema for Garage Services Management PWA
// Based on docs/05-data-model.md

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================
// ENUMS
// ======================

enum UserRole {
  admin
  manager
  mechanic
}

enum JobStatus {
  draft
  open
  in_progress
  waiting_parts
  completed
  invoiced
  closed
}

enum JobPriority {
  low
  normal
  high
  urgent
}

enum JobItemType {
  labor
  part
  other
}

enum ImageCategory {
  entry
  exit
}

enum InvoiceStatus {
  draft
  sent
  paid
  cancelled
}

enum PaymentMethod {
  cash
  card
  upi
  bank_transfer
  other
}

// ======================
// MODELS
// ======================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole  @default(mechanic)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relations
  createdCustomers Customer[]      @relation("CustomerCreatedBy")
  createdVehicles  Vehicle[]       @relation("VehicleCreatedBy")
  createdJobCards  JobCard[]       @relation("JobCardCreatedBy")
  assignedJobCards JobCard[]       @relation("JobCardAssignedMechanic")
  uploadedImages   JobCardImage[]  @relation("ImageUploadedBy")
  createdInvoices  Invoice[]       @relation("InvoiceCreatedBy")
  createdPayments  Payment[]       @relation("PaymentCreatedBy")

  @@map("users")
}

model Customer {
  id        String    @id @default(cuid())
  fullName  String
  mobile    String    @unique // Unique mobile number
  email     String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  // Relations
  creator  User?     @relation("CustomerCreatedBy", fields: [createdBy], references: [id])
  vehicles Vehicle[]
  jobCards JobCard[]
  invoices Invoice[]

  @@index([fullName])
  @@index([mobile])
  @@map("customers")
}

model Vehicle {
  id             String    @id @default(cuid())
  customerId     String
  make           String
  model          String
  year           Int?
  plateNumber    String
  vin            String?
  color          String?
  currentMileage Int?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  deletedAt      DateTime?

  // Relations
  customer Customer  @relation(fields: [customerId], references: [id])
  creator  User?     @relation("VehicleCreatedBy", fields: [createdBy], references: [id])
  jobCards JobCard[]

  @@index([plateNumber])
  @@index([customerId])
  @@map("vehicles")
}

model JobCard {
  id                  String      @id @default(cuid())
  jobNumber           String      @unique
  customerId          String
  vehicleId           String
  status              JobStatus   @default(draft)
  priority            JobPriority @default(normal)
  description         String?
  dateIn              DateTime    @default(now())
  estimatedCompletion DateTime?
  completedAt         DateTime?
  mileageIn           Int?
  mileageOut          Int?
  assignedMechanicId  String?
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  createdBy           String?
  deletedAt           DateTime?

  // Relations
  customer         Customer       @relation(fields: [customerId], references: [id])
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id])
  assignedMechanic User?          @relation("JobCardAssignedMechanic", fields: [assignedMechanicId], references: [id])
  creator          User?          @relation("JobCardCreatedBy", fields: [createdBy], references: [id])
  items            JobCardItem[]
  images           JobCardImage[]
  invoice          Invoice?

  @@index([status])
  @@index([dateIn])
  @@index([assignedMechanicId])
  @@index([customerId])
  @@index([vehicleId])
  @@map("job_cards")
}

model JobCardItem {
  id          String      @id @default(cuid())
  jobCardId   String
  type        JobItemType
  description String
  quantity    Decimal     @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal     @db.Decimal(12, 2)
  partId      String?
  hours       Decimal?    @db.Decimal(8, 2)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  jobCard JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  part    Part?   @relation(fields: [partId], references: [id])

  @@index([jobCardId])
  @@map("job_card_items")
}

model JobCardImage {
  id          String        @id @default(cuid())
  jobCardId   String
  category    ImageCategory
  storagePath String // R2 object key
  fileName    String
  mimeType    String
  sizeBytes   Int?
  caption     String?
  takenAt     DateTime?
  uploadedBy  String?
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?

  // Relations
  jobCard  JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  uploader User?   @relation("ImageUploadedBy", fields: [uploadedBy], references: [id])

  @@index([jobCardId])
  @@index([category])
  @@map("job_card_images")
}

model Part {
  id              String    @id @default(cuid())
  name            String
  sku             String?   @unique
  quantityOnHand  Decimal   @default(0) @db.Decimal(12, 2)
  unitCost        Decimal   @default(0) @db.Decimal(12, 2)
  sellingPrice    Decimal   @default(0) @db.Decimal(12, 2)
  minStockLevel   Decimal   @default(0) @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  jobCardItems JobCardItem[]

  @@map("parts")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  jobCardId     String        @unique
  customerId    String
  status        InvoiceStatus @default(draft)
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  notes         String?
  issuedAt      DateTime?
  dueAt         DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String?

  // Relations
  jobCard  JobCard   @relation(fields: [jobCardId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  creator  User?     @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])
  payments Payment[]

  @@map("invoices")
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  reference String?
  notes     String?
  createdAt DateTime      @default(now())
  createdBy String?

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  creator User?   @relation("PaymentCreatedBy", fields: [createdBy], references: [id])

  @@index([invoiceId])
  @@map("payments")
}
